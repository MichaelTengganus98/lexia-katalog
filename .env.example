# Copy to `.env` next to manage.py, or set these as cPanel "Setup Python App"
# environment variables. Local dev needs NONE of these (sqlite + DEBUG by default).

# ---- environment ----
DJANGO_ENV=staging                     # local | staging | production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# ---- hosts ----
# addon domain or subdomain that serves this install
DJANGO_ALLOWED_HOSTS=staging.lexia.co.id

# ---- database (cPanel MySQL) ----
# Create the DB + user in cPanel > MySQL Databases, then:
DATABASE_URL=mysql://lexiacoi_stg:PASSWORD@localhost/lexiacoi_stg

# ---- paths (match the addon/sub domain document root) ----
DJANGO_STATIC_ROOT=/home/lexiacoi/staging.lexia.co.id/static
DJANGO_MEDIA_ROOT=/home/lexiacoi/staging.lexia.co.id/media

# ---- security ----
DJANGO_SECURE_SSL=1                    # set 0 until the SSL cert for the domain is active
DJANGO_PREPEND_WWW=0                   # keep 0 for staging; 1 only for the apex production domain
# DJANGO_CSRF_TRUSTED_ORIGINS=staging.lexia.co.id

# ---- optional ----
# DJANGO_MEMCACHED_LOCATION=unix:/home/lexiacoi/memcached.sock
